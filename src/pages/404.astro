---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Umbrella Systems"
  description="The page you're looking for doesn't exist or has been moved."
>
  <section class="error-page">
    <!-- Halftone background -->
    <div class="error-halftone" aria-hidden="true"></div>

    <!-- Speed lines -->
    <div class="error-speed-lines" aria-hidden="true">
      <div class="speed-line speed-line-1"></div>
      <div class="speed-line speed-line-2"></div>
      <div class="speed-line speed-line-3"></div>
      <div class="speed-line speed-line-4"></div>
      <div class="speed-line speed-line-5"></div>
      <div class="speed-line speed-line-6"></div>
    </div>

    <div class="error-content">
      <!-- Starburst behind 404 -->
      <div class="error-burst" aria-hidden="true"></div>

      <p class="error-code text-shadow-comic">404</p>
      <h1 class="error-title">MISSION: PAGE NOT FOUND</h1>
      <p class="error-desc">
        Looks like this page took a wrong turn. Even heroes get lost sometimes.
      </p>
      <a href="/" class="btn-comic btn-comic-red error-btn">Back to HQ</a>
      <p class="error-contact">
        If you think something's broken, contact us at
        <a href="mailto:info@umbrellasystems.net">info@umbrellasystems.net</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    background: var(--navy);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 40px 24px;
  }

  /* Halftone */
  .error-halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.04;
  }

  /* Speed lines */
  .error-speed-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .speed-line {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 214, 0, 0.15), transparent);
    transform: rotate(-25deg);
  }
  .speed-line-1 { top: 15%; left: -10%; width: 60%; }
  .speed-line-2 { top: 30%; left: 20%; width: 70%; }
  .speed-line-3 { top: 50%; left: -5%; width: 50%; }
  .speed-line-4 { top: 65%; left: 30%; width: 65%; }
  .speed-line-5 { top: 80%; left: 5%; width: 55%; }
  .speed-line-6 { top: 90%; left: 15%; width: 45%; }

  /* Content */
  .error-content {
    position: relative;
    z-index: 2;
  }

  /* Starburst */
  .error-burst {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -65%);
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(255, 214, 0, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
  }
  .error-burst::before {
    content: '';
    position: absolute;
    inset: -20px;
    background:
      conic-gradient(
        from 0deg,
        transparent 0deg, rgba(255, 214, 0, 0.06) 10deg, transparent 20deg,
        transparent 30deg, rgba(255, 214, 0, 0.06) 40deg, transparent 50deg,
        transparent 60deg, rgba(255, 214, 0, 0.06) 70deg, transparent 80deg,
        transparent 90deg, rgba(255, 214, 0, 0.06) 100deg, transparent 110deg,
        transparent 120deg, rgba(255, 214, 0, 0.06) 130deg, transparent 140deg,
        transparent 150deg, rgba(255, 214, 0, 0.06) 160deg, transparent 170deg,
        transparent 180deg, rgba(255, 214, 0, 0.06) 190deg, transparent 200deg,
        transparent 210deg, rgba(255, 214, 0, 0.06) 220deg, transparent 230deg,
        transparent 240deg, rgba(255, 214, 0, 0.06) 250deg, transparent 260deg,
        transparent 270deg, rgba(255, 214, 0, 0.06) 280deg, transparent 290deg,
        transparent 300deg, rgba(255, 214, 0, 0.06) 310deg, transparent 320deg,
        transparent 330deg, rgba(255, 214, 0, 0.06) 340deg, transparent 350deg
      );
    border-radius: 50%;
  }

  /* 404 number */
  .error-code {
    font-family: 'Bangers', cursive;
    font-size: clamp(8rem, 25vw, 16rem);
    line-height: 1;
    margin: 0;
    color: var(--yellow);
    letter-spacing: 0.06em;
    position: relative;
  }

  /* Title */
  .error-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--white);
    margin: 8px 0 16px;
    letter-spacing: 0.08em;
  }

  /* Description */
  .error-desc {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 36px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  /* Button */
  .error-btn {
    font-size: 1.5rem;
    padding: 16px 40px;
  }

  /* Contact line */
  .error-contact {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 40px;
  }
  .error-contact a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
  }
  .error-contact a:hover {
    color: var(--yellow);
  }
</style>
