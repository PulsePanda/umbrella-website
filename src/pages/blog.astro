---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Dispatch | School IT & E-Rate Blog | Umbrella Systems"
  description="Practical thinking on school IT, E-Rate strategy, network security, and the day-to-day realities of keeping technology working in education. Written by the people who do the work."
>
  <!-- Hero -->
  <section class="blog-hero clip-diagonal-bottom">
    <div class="halftone-light" aria-hidden="true"></div>
    <div class="blog-hero-content container-comic animate-in">
      <h1 class="blog-hero-title text-shadow-comic">THE DISPATCH</h1>
      <p class="blog-hero-sub">
        Practical thinking on school IT, E-Rate strategy, network security, and the day-to-day realities of keeping technology working in education. Written by the people who do the work.
      </p>
    </div>
  </section>

  <!-- Blog Content Area -->
  <section class="blog-content-area">
    <div class="container-comic">
      <div id="blog-content">
        <div id="blog-loading" class="blog-loading">
          <div class="blog-loading-panel comic-card">
            <p>Loading dispatches...</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="blog-cta clip-diagonal-both animate-in">
    <div class="halftone-light" aria-hidden="true"></div>
    <div class="blog-cta-content container-comic">
      <h2 class="blog-cta-title">STAY IN THE LOOP</h2>
      <p class="blog-cta-text">
        We send occasional updates on E-Rate deadlines, school IT best practices, and things we think are worth your time. No spam, no sales pitches — just useful stuff.
      </p>
      <a
        href="https://umbrellasystems.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-comic btn-comic-white"
      >
        Subscribe on Substack
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .blog-hero {
    background: var(--navy);
    color: var(--white);
    padding: 250px 0 120px;
    position: relative;
    overflow: hidden;
  }
  .blog-hero .halftone-light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.06;
  }
  .blog-hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .blog-hero-title {
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 1;
    margin: 0 0 24px;
    color: var(--yellow);
  }
  .blog-hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 620px;
    margin: 0 auto;
  }

  /* ---- Blog Content ---- */
  .blog-content-area {
    background: var(--white);
    padding: 80px 0 60px;
    position: relative;
  }

  .blog-loading {
    text-align: center;
    padding: 60px 0;
  }
  .blog-loading-panel {
    display: inline-block;
    font-family: 'Bangers', cursive;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }

  /* ---- Newsletter CTA ---- */
  .blog-cta {
    background: var(--red);
    color: var(--white);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }
  .blog-cta .halftone-light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.06;
  }
  .blog-cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .blog-cta-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 20px;
    color: var(--white);
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.3);
  }
  .blog-cta-text {
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 32px;
    color: rgba(255, 255, 255, 0.9);
  }
</style>

<!-- Blog card styles injected globally so client-side JS can use them -->
<style is:global>
  /* ---- Blog Cards ---- */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 60px;
  }
  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-card-featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    background: var(--white);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  @media (min-width: 768px) {
    .blog-card-featured {
      grid-template-columns: 1fr 1fr;
    }
  }
  .blog-card-featured:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0px var(--navy);
  }
  .blog-card-featured-img {
    background: var(--navy);
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .blog-card-featured-img::after {
    content: 'FEATURED';
    position: absolute;
    top: 16px;
    left: -32px;
    background: var(--red);
    color: var(--white);
    font-family: 'Bangers', cursive;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 6px 40px;
    transform: rotate(-35deg);
    border: 2px solid var(--navy);
  }
  .blog-card-featured-body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .blog-card-featured .blog-card-category {
    background: var(--red);
    color: var(--white);
  }
  .blog-card-featured .blog-card-title {
    font-size: 2rem;
  }

  .blog-card {
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    background: var(--white);
    overflow: hidden;
    text-decoration: none;
    color: var(--navy);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .blog-card:hover {
    transform: translate(-3px, -3px) rotate(0deg) !important;
    box-shadow: 7px 7px 0px var(--navy);
  }
  .blog-card:nth-child(3) {
    transform: rotate(0.8deg);
  }
  .blog-card:nth-child(4) {
    transform: rotate(-0.6deg);
  }
  .blog-card:nth-child(5) {
    transform: rotate(0.4deg);
  }

  .blog-card-stripe {
    height: 6px;
    background: var(--red);
  }
  .blog-card-body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.8rem;
  }
  .blog-card-category {
    display: inline-block;
    background: var(--navy);
    color: var(--yellow);
    font-family: 'Bangers', cursive;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border: 2px solid var(--navy);
  }
  .blog-card-date {
    color: var(--gray);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .blog-card-title {
    font-size: 1.4rem;
    line-height: 1.2;
    margin: 0 0 10px;
    color: var(--navy);
  }
  .blog-card-excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    flex: 1;
    margin: 0;
  }
  .blog-card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-family: 'Bangers', cursive;
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--red);
    text-decoration: none;
  }
  .blog-card-link:hover {
    color: var(--red-dark);
  }

  /* ---- Empty State ---- */
  .blog-empty {
    text-align: center;
    padding: 60px 32px;
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    background: var(--white);
    max-width: 600px;
    margin: 0 auto;
  }
  .blog-empty-title {
    font-size: 2rem;
    margin: 0 0 12px;
    color: var(--navy);
  }
  .blog-empty-text {
    font-size: 1rem;
    color: #555;
    margin: 0 0 28px;
    line-height: 1.6;
  }
</style>

<script>
  import { fetchSubstackPosts, formatDate } from '../lib/rss';

  const externalIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;

  function renderEmpty(): string {
    return `
      <div class="blog-empty">
        <h2 class="blog-empty-title">WE'RE WORKING ON OUR FIRST DISPATCHES.</h2>
        <p class="blog-empty-text">Check back soon — or subscribe so you don't miss a thing.</p>
        <a href="https://umbrellasystems.substack.com" target="_blank" rel="noopener noreferrer"
          class="btn-comic btn-comic-red">
          Subscribe on Substack
        </a>
      </div>`;
  }

  function renderFeatured(post: { title: string; link: string; pubDate: string; description: string; category: string }): string {
    return `
      <a href="${post.link}" target="_blank" rel="noopener noreferrer" class="blog-card-featured" aria-label="Featured: ${post.title}">
        <div class="blog-card-featured-img">
          <span style="color: rgba(255,255,255,0.3); font-family: 'Bangers', cursive; font-size: 3rem; letter-spacing: 0.06em;">THE DISPATCH</span>
        </div>
        <div class="blog-card-featured-body">
          <div class="blog-card-meta">
            <span class="blog-card-category">${post.category}</span>
            <span class="blog-card-date">${formatDate(post.pubDate)}</span>
          </div>
          <h2 class="blog-card-title">${post.title}</h2>
          <p class="blog-card-excerpt">${post.description}</p>
          <span class="blog-card-link">
            Read on Substack ${externalIcon}
          </span>
        </div>
      </a>`;
  }

  function renderCard(post: { title: string; link: string; pubDate: string; description: string; category: string }): string {
    return `
      <a href="${post.link}" target="_blank" rel="noopener noreferrer" class="blog-card" aria-label="${post.title}">
        <div class="blog-card-stripe"></div>
        <div class="blog-card-body">
          <div class="blog-card-meta">
            <span class="blog-card-category">${post.category}</span>
            <span class="blog-card-date">${formatDate(post.pubDate)}</span>
          </div>
          <h3 class="blog-card-title">${post.title}</h3>
          <p class="blog-card-excerpt">${post.description}</p>
          <span class="blog-card-link">
            Read ${externalIcon}
          </span>
        </div>
      </a>`;
  }

  async function loadBlog() {
    const container = document.getElementById('blog-content')!;
    const posts = await fetchSubstackPosts();

    if (posts.length === 0) {
      container.innerHTML = renderEmpty();
      return;
    }

    const featured = posts[0];
    const rest = posts.slice(1);

    container.innerHTML = `
      <div class="blog-grid">
        ${renderFeatured(featured)}
        ${rest.map(post => renderCard(post)).join('')}
      </div>`;
  }

  loadBlog();
</script>
