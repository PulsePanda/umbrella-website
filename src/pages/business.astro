---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Managed IT for Minnesota Businesses | Umbrella Systems"
  description="Flat-rate managed IT for Minnesota businesses. On-site and remote support, network security, and security cameras — all under one predictable monthly cost."
>
  <!-- Hero -->
  <section class="biz-hero clip-diagonal-bottom">
    <div class="halftone-light" aria-hidden="true"></div>
    <div class="biz-hero-inner container-comic">
      <div class="biz-hero-content animate-in">
        <h1 class="biz-hero-title text-shadow-comic">
          WE BUILT OUR SYSTEMS FOR SCHOOLS. THEY WORK JUST AS WELL FOR <span class="highlight">BUSINESSES.</span>
        </h1>
        <p class="biz-hero-sub">
          The same flat-rate pricing, proactive monitoring, and named technicians that Minnesota charter schools rely on — available for local businesses too.
        </p>
        <div class="biz-hero-ctas">
          <a href="/contact" class="btn-comic btn-comic-red">Get in Touch</a>
          <a href="#services" class="btn-comic btn-comic-yellow">View Services</a>
        </div>
      </div>
      <div class="biz-hero-image animate-in">
        <img src="/images/av-display-install.jpg" alt="Umbrella Systems commercial AV display installation" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Services Bento -->
  <section id="services" class="biz-services">
    <div class="halftone" aria-hidden="true"></div>
    <div class="container-comic biz-services-inner">
      <h2 class="biz-services-title animate-in">EVERYTHING YOUR BUSINESS NEEDS</h2>
      <div class="biz-services-grid">
        <div class="biz-service-card biz-service-wide comic-card animate-in">
          <div class="biz-service-icon" aria-hidden="true">
            <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="biz-service-name">MANAGED IT SUPPORT</h3>
          <p class="biz-service-desc">
            On-site and remote support for your entire technology environment. Workstations, servers, printers, software — all covered under one predictable monthly rate.
          </p>
        </div>

        <div class="biz-service-card comic-card animate-in">
          <div class="biz-service-icon" aria-hidden="true">
            <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="biz-service-name">NETWORK & SECURITY</h3>
          <p class="biz-service-desc">
            24/7 network monitoring, firewall management, and cybersecurity best practices. We keep your systems secure and your data protected.
          </p>
        </div>

        <div class="biz-service-card comic-card animate-in">
          <div class="biz-service-icon" aria-hidden="true">
            <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="biz-service-name">SECURITY CAMERAS</h3>
          <p class="biz-service-desc">
            Professional installation, configuration, and ongoing maintenance. Live dashboards so you can see what's happening across your facility.
          </p>
        </div>

        <div class="biz-service-card biz-service-wide biz-service-pricing animate-in">
          <div class="biz-service-pricing-badge starburst">NO SURPRISES</div>
          <h3 class="biz-service-name">FLAT-RATE PRICING</h3>
          <p class="biz-service-desc">
            No hourly rates, no per-ticket charges, no surprise invoices. One monthly cost covers everything — budget with confidence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="biz-philosophy">
    <div class="container-comic">
      <div class="speech-bubble animate-in" style="background: var(--yellow);">
        <p class="biz-philosophy-text">
          We don't do the revolving-door technician thing. When you work with Umbrella, you get a small, consistent team that knows your systems and your people. We're based in Minnesota, we answer our phones, and we show up when we say we will.
        </p>
        <p class="biz-philosophy-attr">— The Umbrella Team</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="biz-cta clip-diagonal-top">
    <div class="halftone-light" aria-hidden="true"></div>
    <div class="container-comic biz-cta-inner animate-in">
      <h2 class="biz-cta-title text-shadow-comic">LET'S TALK ABOUT YOUR BUSINESS IT</h2>
      <p class="biz-cta-sub">
        We'll review your current setup, identify gaps, and put together a flat-rate proposal that covers everything.
      </p>
      <a href="/contact" class="btn-comic btn-comic-white">Get in Touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .biz-hero {
    background: var(--navy);
    color: var(--white);
    padding: 250px 0 120px;
    position: relative;
    overflow: hidden;
  }
  .biz-hero .halftone-light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.06;
  }
  .biz-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .biz-hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 60px;
    }
  }
  .biz-hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0 0 20px;
    color: var(--white);
  }
  .biz-hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 32px;
    max-width: 540px;
  }
  .biz-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .biz-hero-image {
    border: var(--border-comic);
    box-shadow: 6px 6px 0 rgba(255, 214, 0, 0.5);
    overflow: hidden;
    transform: rotate(2deg);
  }
  .biz-hero-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* ---- Services ---- */
  .biz-services {
    padding: 80px 0 100px;
    background: var(--white);
    position: relative;
  }
  .biz-services .halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--navy) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.04;
  }
  .biz-services-inner {
    position: relative;
    z-index: 1;
  }
  .biz-services-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    margin: 0 0 48px;
    color: var(--navy);
  }
  .biz-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .biz-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .biz-service-wide {
      grid-column: 1 / -1;
    }
  }

  .biz-service-card {
    padding: 36px !important;
    position: relative;
  }
  .biz-service-icon {
    width: 56px;
    height: 56px;
    background: var(--yellow);
    border: 2px solid var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--navy);
  }
  .biz-service-name {
    font-size: 1.6rem;
    margin: 0 0 10px;
    color: var(--navy);
  }
  .biz-service-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
    max-width: 600px;
  }
  .biz-service-pricing {
    text-align: center;
  }
  .biz-service-pricing .biz-service-pricing-badge {
    margin-bottom: 20px;
  }
  .biz-service-pricing .biz-service-name {
    font-size: 2rem;
  }
  .biz-service-pricing .biz-service-desc {
    max-width: 480px;
    margin: 0 auto;
  }
  .biz-service-pricing .biz-service-icon {
    display: none;
  }

  /* ---- Philosophy ---- */
  .biz-philosophy {
    padding: 80px 0 100px;
    background: var(--white);
  }
  .biz-philosophy .speech-bubble {
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
  }
  .biz-philosophy-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--navy);
    margin: 0 0 16px;
    font-style: italic;
  }
  .biz-philosophy-attr {
    font-family: 'Bangers', cursive;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: var(--navy);
    margin: 0;
    opacity: 0.7;
  }

  /* ---- CTA ---- */
  .biz-cta {
    background: var(--red);
    color: var(--white);
    padding: 120px 0 80px;
    position: relative;
    overflow: hidden;
  }
  .biz-cta .halftone-light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.06;
  }
  .biz-cta-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .biz-cta-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 20px;
    color: var(--white);
  }
  .biz-cta-sub {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 32px;
  }
</style>
