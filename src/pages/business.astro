---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import HearthNote from '../components/ui/HearthNote.astro';
---

<BaseLayout
  title="Managed IT for Minnesota Businesses | Umbrella Systems"
  description="Flat-rate managed IT for Minnesota businesses. On-site and remote support, network security, and security cameras — all under one predictable monthly cost."
>
  <!-- Hero Section -->
  <section class="relative px-6 lg:px-8 py-20 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 space-y-8">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary-container text-secondary font-bold text-xs uppercase tracking-widest">Local Partner: Minnesota Business</span>
      <h1 class="text-4xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight text-on-surface">
        We built our systems for schools. They work just as well for businesses.
      </h1>
      <p class="text-xl text-on-surface-variant leading-relaxed max-w-2xl">
        The same flat-rate pricing, proactive monitoring, and named technicians that Minnesota charter schools rely on — available for local businesses too.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/contact">Get in Touch</Button>
        <Button variant="secondary" href="/services/managed-it">View Services</Button>
      </div>
    </div>
    <div class="lg:col-span-5 relative">
      <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl rotate-2 bg-surface-container-high aspect-[4/5]">
        <img src="/images/av-display-install.jpg" alt="Umbrella Systems commercial AV display installation" class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="absolute -bottom-6 -left-6 w-48 h-48 bg-tertiary-fixed rounded-2xl -z-10 rotate-12 opacity-50"></div>
    </div>
  </section>

  <!-- Services Bento -->
  <section class="px-6 lg:px-8 py-20 lg:py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-extrabold mb-4 text-on-surface">Everything your business needs.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Managed IT -->
        <div class="md:col-span-2 bg-surface-container-lowest p-8 lg:p-10 rounded-xl border border-outline-variant/15 flex flex-col md:flex-row gap-8 items-center">
          <div class="flex-1 space-y-4">
            <h3 class="text-2xl font-bold">Managed IT Support</h3>
            <p class="text-on-surface-variant leading-relaxed">On-site and remote support for your entire technology environment. Workstations, servers, printers, software — all covered under one predictable monthly rate.</p>
          </div>
          <div class="w-full md:w-1/3 h-40 rounded-xl bg-surface-container-high overflow-hidden">
            <img src="/images/tv-mount-install.jpg" alt="TV mount installation in progress" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
        <!-- Network & Security -->
        <div class="bg-primary p-8 lg:p-10 rounded-xl text-on-primary flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-bold mb-4">Network & Security</h3>
            <p class="opacity-90 leading-relaxed">24/7 network monitoring, firewall management, and cybersecurity best practices. We keep your systems secure and your data protected.</p>
          </div>
        </div>
        <!-- Security Cameras -->
        <div class="bg-secondary p-8 lg:p-10 rounded-xl text-on-secondary">
          <h3 class="text-2xl font-bold mb-4">Security Cameras</h3>
          <p class="opacity-90">Professional installation, configuration, and ongoing maintenance. Live dashboards so you can see what's happening across your facility.</p>
        </div>
        <!-- Flat-Rate Pricing -->
        <div class="md:col-span-2 bg-tertiary-fixed p-8 lg:p-10 rounded-xl flex items-center gap-8">
          <div class="flex-1">
            <h3 class="text-2xl font-bold mb-2 text-on-surface">Flat-Rate Pricing</h3>
            <p class="text-on-surface-variant">No hourly rates, no per-ticket charges, no surprise invoices. One monthly cost covers everything — budget with confidence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Callout -->
  <section class="px-6 lg:px-8 py-16 lg:py-20 max-w-5xl mx-auto">
    <HearthNote class="relative overflow-hidden">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <div>
          <p class="text-on-surface text-lg lg:text-xl italic leading-relaxed">
            We don't do the revolving-door technician thing. When you work with Umbrella, you get a small, consistent team that knows your systems and your people. We're based in Minnesota, we answer our phones, and we show up when we say we will.
          </p>
          <p class="mt-4 font-bold text-tertiary">— The Umbrella Team</p>
        </div>
      </div>
    </HearthNote>
  </section>

  <!-- CTA Section -->
  <section class="px-6 lg:px-8 py-20 lg:py-24 text-center">
    <div class="max-w-4xl mx-auto space-y-8">
      <h2 class="text-3xl lg:text-5xl font-extrabold text-on-surface">Let's talk about your business IT.</h2>
      <p class="text-xl text-on-surface-variant max-w-2xl mx-auto">We'll review your current setup, identify gaps, and put together a flat-rate proposal that covers everything.</p>
      <div class="pt-4">
        <Button href="/contact">Get in Touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
