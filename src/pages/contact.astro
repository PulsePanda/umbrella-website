---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Umbrella Systems | Call In The Team"
  description="Get in touch with Umbrella Systems. Schedule a tour, ask a question, or reach our 24/7 emergency line for critical support."
>
  <!-- Hero -->
  <section class="contact-hero clip-diagonal-bottom">
    <div class="halftone-light" aria-hidden="true"></div>
    <div class="contact-hero-content container-comic animate-in">
      <h1 class="contact-hero-title text-shadow-comic">
        GET IN <span class="highlight">TOUCH</span>
      </h1>
      <p class="contact-hero-sub">
        Whether you're exploring a partnership or just have a question, we'd like to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="contact-section">
    <div class="container-comic">
      <div class="contact-grid">
        <!-- Left: Form -->
        <div class="contact-form-panel animate-in">
          <div class="contact-form-titlebar">SEND US A SIGNAL</div>
          <div class="contact-form-body">
            <p class="contact-form-note">Fields marked with <span class="contact-required">*</span> are required.</p>
            <form id="contact-form">
              <div class="contact-field">
                <label for="contact-name">Name <span class="contact-required">*</span></label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  aria-required="true"
                  placeholder="Your name"
                />
              </div>
              <div class="contact-field">
                <label for="contact-email">Email <span class="contact-required">*</span></label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  aria-required="true"
                  placeholder="you@example.com"
                />
              </div>
              <div class="contact-field">
                <label for="contact-org">Organization</label>
                <input
                  id="contact-org"
                  name="organization"
                  type="text"
                  placeholder="School or business name"
                />
              </div>
              <div class="contact-field">
                <label for="contact-message">Message <span class="contact-required">*</span></label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  aria-required="true"
                  rows="5"
                  placeholder="Tell us about your IT needs..."
                ></textarea>
              </div>
              <button type="submit" class="btn-comic btn-comic-red contact-submit-btn">
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Info Panels -->
        <div class="contact-info-col">
          <!-- Emergency Panel -->
          <div class="contact-emergency animate-in">
            <div class="contact-emergency-badge" aria-hidden="true">24/7</div>
            <h2 class="contact-emergency-title">EMERGENCY SUPPORT</h2>
            <a href="tel:6127562992" class="contact-emergency-phone">(612) 756-2992</a>
            <p class="contact-emergency-note">For existing partners with critical issues outside business hours.</p>
          </div>

          <!-- Contact Details Card -->
          <div class="contact-details-card comic-card animate-in">
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <p class="contact-detail-label">Main Office</p>
                <p class="contact-detail-value"><a href="tel:6514094321">(651) 409-4321</a></p>
              </div>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <p class="contact-detail-label">Email</p>
                <p class="contact-detail-value"><a href="mailto:info@umbrellasystems.net">info@umbrellasystems.net</a></p>
              </div>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <p class="contact-detail-label">Address</p>
                <address class="contact-detail-value contact-address">
                  15838 Harwell Ave<br />Apple Valley, MN 55124
                </address>
              </div>
            </div>
            <div class="contact-detail-row">
              <div class="contact-detail-icon" aria-hidden="true">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <p class="contact-detail-label">Service Area</p>
                <p class="contact-detail-value">Minnesota — statewide</p>
              </div>
            </div>
          </div>

          <!-- Map -->
          <div class="contact-map-panel animate-in">
            <img
              src="/images/map.png"
              alt="Map showing Umbrella Systems location in Apple Valley, Minnesota"
              loading="lazy"
              decoding="async"
              width="600"
              height="300"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .contact-hero {
    background: var(--navy);
    color: var(--white);
    padding: 250px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .contact-hero .halftone-light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--white) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.06;
  }
  .contact-hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }
  .contact-hero-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1.05;
    margin: 0 0 20px;
    color: var(--white);
  }
  .contact-hero-sub {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 500px;
    margin: 0;
  }

  /* ---- Contact Section ---- */
  .contact-section {
    padding: 80px 0 100px;
    background: var(--white);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 7fr 5fr;
      gap: 48px;
    }
  }

  /* ---- Form Panel ---- */
  .contact-form-panel {
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    background: var(--white);
    overflow: hidden;
  }
  .contact-form-titlebar {
    background: var(--navy);
    color: var(--yellow);
    font-family: 'Bangers', cursive;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    padding: 14px 24px;
    border-bottom: 4px solid var(--yellow);
  }
  .contact-form-body {
    padding: 32px;
  }
  .contact-form-note {
    font-size: 0.85rem;
    color: var(--gray);
    margin: 0 0 24px;
  }
  .contact-required {
    color: var(--red);
    font-weight: 700;
  }
  .contact-field {
    margin-bottom: 20px;
  }
  .contact-field label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 6px;
    color: var(--navy);
  }
  .contact-field input,
  .contact-field textarea {
    width: 100%;
    padding: 12px 16px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    border: var(--border-comic);
    border-radius: 0;
    background: var(--white);
    color: var(--navy);
    transition: box-shadow 0.15s;
    box-sizing: border-box;
  }
  .contact-field input:focus,
  .contact-field textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--red), var(--shadow-comic-sm);
  }
  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: var(--gray);
  }
  .contact-submit-btn {
    width: 100%;
    text-align: center;
    margin-top: 8px;
  }

  /* ---- Info Column ---- */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* ---- Emergency Panel ---- */
  .contact-emergency {
    background: var(--red);
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    padding: 28px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .contact-emergency-badge {
    display: inline-block;
    background: var(--yellow);
    color: var(--navy);
    font-family: 'Bangers', cursive;
    font-size: 1.6rem;
    letter-spacing: 0.06em;
    padding: 6px 20px;
    border: 3px solid var(--navy);
    box-shadow: 3px 3px 0 var(--navy);
    margin-bottom: 12px;
    transform: rotate(-3deg);
  }
  .contact-emergency-title {
    color: var(--white);
    font-size: 1.5rem;
    margin: 0 0 12px;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
  }
  .contact-emergency-phone {
    display: block;
    color: var(--white);
    font-family: 'Bangers', cursive;
    font-size: 2.4rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    margin-bottom: 8px;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
  }
  .contact-emergency-phone:hover {
    color: var(--yellow);
  }
  .contact-emergency-note {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    font-style: italic;
  }

  /* ---- Contact Details Card ---- */
  .contact-details-card {
    padding: 28px !important;
  }
  .contact-detail-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 14px 0;
    border-bottom: 2px dashed rgba(26, 26, 46, 0.15);
  }
  .contact-detail-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .contact-detail-row:first-child {
    padding-top: 0;
  }
  .contact-detail-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--yellow);
    border: 2px solid var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
  }
  .contact-detail-label {
    font-family: 'Bangers', cursive;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--gray);
    margin: 0 0 2px;
    text-transform: uppercase;
  }
  .contact-detail-value {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    color: var(--navy);
  }
  .contact-detail-value a {
    color: var(--navy);
    text-decoration: none;
  }
  .contact-detail-value a:hover {
    color: var(--red);
  }
  .contact-address {
    font-style: normal;
    font-weight: 500;
    line-height: 1.5;
  }

  /* ---- Map ---- */
  .contact-map-panel {
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    overflow: hidden;
    line-height: 0;
  }
  .contact-map-panel img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    submitBtn.style.opacity = '0.7';
    submitBtn.style.cursor = 'not-allowed';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      await fetch('https://hooks.zapier.com/hooks/catch/13655244/upwa4tc/', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' },
        mode: 'no-cors',
      });

      form.innerHTML = `
        <div style="text-align: center; padding: 48px 0;">
          <div style="font-family: 'Bangers', cursive; font-size: 3rem; color: var(--navy); margin-bottom: 8px;">MESSAGE SENT!</div>
          <p style="font-size: 1.05rem; color: var(--gray);">We'll get back to you soon.</p>
        </div>
      `;
    } catch {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
      submitBtn.style.opacity = '1';
      submitBtn.style.cursor = 'pointer';

      const errorMsg = document.createElement('p');
      errorMsg.style.cssText = 'color: var(--red); font-size: 0.9rem; margin-top: 12px; text-align: center;';
      errorMsg.textContent = 'Something went wrong. Please try again or call us at (651) 409-4321.';
      submitBtn.after(errorMsg);
    }
  });
</script>
