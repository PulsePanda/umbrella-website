---
import BaseLayout from '../layouts/BaseLayout.astro';
import HearthNote from '../components/ui/HearthNote.astro';
---

<BaseLayout
  title="Contact Umbrella Systems | School IT Support Minnesota"
  description="Get in touch with Umbrella Systems. Schedule a tour, ask a question, or reach our 24/7 emergency line for critical support."
>
  <section class="px-6 lg:px-8 pt-8 pb-20 max-w-7xl mx-auto">
    <!-- Header -->
    <header class="mb-16 lg:mb-24">
      <h1 class="font-extrabold text-5xl lg:text-7xl text-on-surface tracking-tight leading-[1.1] mb-6">
        Get in touch.
      </h1>
      <p class="text-secondary text-xl lg:text-2xl max-w-2xl leading-relaxed">
        Whether you're exploring a partnership or just have a question, we'd like to hear from you.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Form -->
      <div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-12 rounded-xl border border-outline-variant/15">
        <h2 class="font-bold text-2xl lg:text-3xl mb-8">Send us a message</h2>
        <p class="text-sm text-on-surface-variant mb-6">Fields marked with <span class="text-primary">*</span> are required.</p>
        <form id="contact-form" class="space-y-6">
          <div class="space-y-2">
            <label for="contact-name" class="block text-sm font-bold text-on-surface-variant">Name <span class="text-primary">*</span></label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              aria-required="true"
              class="w-full bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary transition-all p-4 placeholder:text-outline"
              placeholder="Your name"
            />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="block text-sm font-bold text-on-surface-variant">Email <span class="text-primary">*</span></label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              aria-required="true"
              class="w-full bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary transition-all p-4 placeholder:text-outline"
              placeholder="you@school.edu"
            />
          </div>
          <div class="space-y-2">
            <label for="contact-org" class="block text-sm font-bold text-on-surface-variant">Organization</label>
            <input
              id="contact-org"
              name="organization"
              type="text"
              class="w-full bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary transition-all p-4 placeholder:text-outline"
              placeholder="School or business name"
            />
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="block text-sm font-bold text-on-surface-variant">Message <span class="text-primary">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              required
              aria-required="true"
              rows="5"
              class="w-full bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary transition-all p-4 placeholder:text-outline"
              placeholder="Tell us about your IT needs..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full hearth-gradient text-on-primary font-extrabold text-lg py-5 rounded-lg hover:opacity-95 transition-all shadow-xl shadow-primary/20 active:scale-[0.98]"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Emergency Note -->
        <HearthNote>
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-6 h-6 text-on-surface" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.072 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>
            <h3 class="font-bold text-xl uppercase tracking-wider text-on-surface">24/7 Emergency Support</h3>
          </div>
          <p class="font-bold text-3xl lg:text-4xl text-on-surface mb-2">
            <a href="tel:6513009536">(651) 300-9536</a>
          </p>
          <p class="italic text-on-surface-variant text-sm">For existing partners with critical issues outside business hours.</p>
        </HearthNote>

        <!-- Contact Details Card -->
        <div class="bg-surface-container-low p-8 rounded-xl space-y-8">
          <div class="flex gap-6 items-start">
            <div class="bg-secondary/10 p-3 rounded-lg text-secondary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-secondary uppercase tracking-widest mb-1">Main Office</p>
              <p class="text-xl lg:text-2xl font-bold"><a href="tel:6514094321">(651) 409-4321</a></p>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="bg-secondary/10 p-3 rounded-lg text-secondary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-secondary uppercase tracking-widest mb-1">Address</p>
              <address class="not-italic text-lg lg:text-xl leading-relaxed">
                15838 Harwell Ave<br />Apple Valley, MN 55124
              </address>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="bg-secondary/10 p-3 rounded-lg text-secondary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-secondary uppercase tracking-widest mb-1">Service Area</p>
              <p class="text-lg lg:text-xl">Minnesota — statewide</p>
            </div>
          </div>
        </div>

        <!-- Map Placeholder -->
        <div class="rounded-xl overflow-hidden h-64 bg-surface-container-highest relative flex items-center justify-center">
          <span class="text-on-surface-variant text-sm">Map — Apple Valley, MN</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      submitBtn.classList.add('opacity-75', 'cursor-not-allowed');

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        await fetch('https://hooks.zapier.com/hooks/catch/13655244/upwa4tc/', {
          method: 'POST',
          body: JSON.stringify(data),
          headers: { 'Content-Type': 'application/json' },
          mode: 'no-cors',
        });

        form.innerHTML = `
          <div class="text-center py-12">
            <div class="text-tertiary mb-4">
              <svg class="w-16 h-16 mx-auto" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <h3 class="font-extrabold text-2xl text-on-surface mb-2">Message sent.</h3>
            <p class="text-on-surface-variant text-lg">We'll get back to you soon.</p>
          </div>
        `;
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');

        const errorMsg = document.createElement('p');
        errorMsg.className = 'text-primary text-sm mt-4 text-center';
        errorMsg.textContent = 'Something went wrong. Please try again or call us at (651) 409-4321.';
        submitBtn.after(errorMsg);
      }
    });
  </script>
</BaseLayout>
