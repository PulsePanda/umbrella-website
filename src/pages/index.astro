  <!-- Hero Flyer Scroll-Away Script -->
  <script>
    const heroSection = document.querySelector<HTMLElement>('.hero');
    const flyerScroll = document.querySelector<HTMLElement>('.hero-flyer-scroll');

    if (heroSection && flyerScroll) {
      let ticking = false;

      const update = () => {
        const rect = heroSection.getBoundingClientRect();
        const height = Math.max(rect.height, 1);
        const raw = -rect.top / height;
        const progress = Math.min(Math.max(raw, 0), 1);

        const tx = progress * 90;    // vw — drift to the right
        const ty = -progress * 70;   // vh — drift upward
        const tr = progress * 38;    // degrees — bank into the exit

        flyerScroll.style.setProperty('--scroll-x', `${tx}vw`);
        flyerScroll.style.setProperty('--scroll-y', `${ty}vh`);
        flyerScroll.style.setProperty('--scroll-r', `${tr}deg`);
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  </script>
