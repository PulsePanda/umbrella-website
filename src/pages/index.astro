---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Managed IT for Minnesota Charter Schools | Umbrella Systems"
  description="Umbrella Systems is outsourced IT for Minnesota charter schools. On-site support, network management, E-Rate optimization, and flat-rate pricing. No surprises."
>
  <!-- =============================== -->
  <!-- HERO with Flying Superhero      -->
  <!-- =============================== -->
  <section class="hero" style="position:relative; overflow:hidden; padding-top:160px !important; padding-bottom:140px; background:var(--navy);">
    <!-- Halftone dots -->
    <div class="halftone-light" style="position:absolute; inset:0; z-index:2;"></div>

    <!-- Diagonal stripes -->
    <div style="position:absolute; inset:0; z-index:2; opacity:0.04; background:repeating-linear-gradient(45deg, transparent, transparent 10px, var(--white) 10px, var(--white) 12px);" aria-hidden="true"></div>

    <!-- Geometric shapes -->
    <div style="position:absolute; top:10%; right:8%; width:80px; height:80px; border:3px solid var(--yellow); opacity:0.2; transform:rotate(15deg); z-index:2;" aria-hidden="true"></div>
    <div style="position:absolute; bottom:20%; left:5%; width:60px; height:60px; border:3px solid var(--red); border-radius:50%; opacity:0.15; z-index:2;" aria-hidden="true"></div>
    <div style="position:absolute; top:30%; right:15%; width:0; height:0; border-left:30px solid transparent; border-right:30px solid transparent; border-bottom:50px solid var(--yellow); opacity:0.1; z-index:2;" aria-hidden="true"></div>

    <!-- Flying superhero — fly-in on load, fly-away on scroll -->
    <div class="hero-flyer" aria-hidden="true">
      <div class="hero-flyer-fly">
        <div class="hero-flyer-scroll">
          <img src="/images/hero-flyer.png" alt="" class="hero-flyer-svg" width="1600" height="893" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>

    <!-- Hero content -->
    <div class="container-comic" style="position:relative; z-index:10; text-align:center;">
      <div style="max-width:800px; margin:0 auto;">
        <div class="starburst animate-in" style="margin-bottom:32px;">
          OUTSOURCED IT FOR MINNESOTA SCHOOLS
        </div>

        <h1 class="animate-in text-shadow-comic" style="font-size:clamp(3rem, 8vw, 5.5rem); color:var(--white); line-height:1.05; margin-bottom:24px;">
          EVERY SCHOOL<br />DESERVES A <span class="highlight">HERO</span>
        </h1>

        <p class="animate-in" style="font-size:1.15rem; color:rgba(255,255,255,0.9); max-width:620px; margin:0 auto 40px; line-height:1.7;">
          Umbrella Systems is the IT team that drops everything when your school needs help. We handle everything from Chromebooks to cybersecurity &mdash; so your staff can focus on students, not troubleshooting.
        </p>

        <div class="animate-in" style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; align-items:center;">
          <a href="/contact" class="btn-comic btn-comic-red">CALL IN THE TEAM</a>
          <a href="#origin" style="color:var(--yellow); font-family:'Bangers',cursive; font-size:1.15rem; letter-spacing:0.04em; text-decoration:none; padding:14px 8px;">OUR ORIGIN STORY &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Slanted separator — paints a white diagonal into the hero's bottom-right -->
    <div class="hero-slant-bottom" aria-hidden="true"></div>
  </section>

  <!-- =============================== -->
  <!-- CORE MESSAGE BAND               -->
  <!-- =============================== -->
  <section style="background:var(--navy); padding:140px 24px; text-align:center; position:relative; overflow:hidden;">
    <!-- Top slant — completes the hero's bottom slant with a white diagonal cut -->
    <div class="core-message-slant-top" aria-hidden="true"></div>
    <!-- Bottom slant — gray-light so the transition to the Superpowers section reads as seamless -->
    <div class="core-message-slant-bottom" aria-hidden="true"></div>

    <div class="container-comic" style="position:relative; z-index:2;">
      <h2 class="animate-in" style="font-size:clamp(1.6rem, 4vw, 2.8rem); color:var(--white); line-height:1.3;">
        &ldquo;If it plugs in, connects to <span class="highlight">Wi-Fi</span>, or needs a login &mdash; we support it.&rdquo;
      </h2>
    </div>
  </section>

  <!-- =============================== -->
  <!-- SERVICES "OUR SUPERPOWERS"      -->
  <!-- =============================== -->
  <section style="padding:100px 24px; background:var(--gray-light); position:relative;">
    <!-- Halftone bg -->
    <div class="halftone" style="position:absolute; inset:0;"></div>

    <div class="container-comic" style="position:relative; z-index:1;">
      <div style="text-align:center; margin-bottom:64px;">
        <h2 class="animate-in" style="font-size:clamp(2.2rem, 5vw, 3.5rem); color:var(--navy);">OUR <span class="highlight">SUPERPOWERS</span></h2>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:32px; max-width:1100px; margin:0 auto;">
        <!-- Card 1: Lightning Response -->
        <a href="/services/managed-it" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(-1deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><path d="M28 4L8 28h14l-4 16 20-24H24l4-16z" fill="var(--yellow)" stroke="var(--navy)" stroke-width="2" stroke-linejoin="round"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">LIGHTNING RESPONSE</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            On-site support scaled to your school, unlimited remote helpdesk, full device lifecycle management. No hourly rates. No caps. No surprises.
          </p>
        </a>

        <!-- Card 2: Fortress Network -->
        <a href="/services/network-infrastructure" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(0.8deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><path d="M24 4L6 14v12c0 10.5 7.7 20.3 18 22.8C34.3 46.3 42 36.5 42 26V14L24 4z" fill="var(--red)" stroke="var(--navy)" stroke-width="2" stroke-linejoin="round"/><path d="M18 24l4 4 8-8" stroke="var(--white)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">FORTRESS NETWORK</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            24/7 monitoring, firewall management, wireless optimization, and disaster recovery. 99.9% uptime &mdash; and we handle the E-Rate paperwork to fund it.
          </p>
        </a>

        <!-- Card 3: Strategic Vision -->
        <a href="/services/it-leadership" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(-0.5deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><circle cx="24" cy="20" r="14" fill="var(--navy)" stroke="var(--navy)" stroke-width="2"/><path d="M16 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="round"/><circle cx="24" cy="20" r="3" fill="var(--yellow)"/><path d="M18 38l2-10h8l2 10" stroke="var(--navy)" stroke-width="2" fill="var(--yellow)" stroke-linejoin="round"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">STRATEGIC VISION</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            Strategic technology planning, hardware procurement at vendor-direct pricing, compliance oversight, and long-term roadmapping. Think of it as a vCIO without the six-figure salary.
          </p>
        </a>

        <!-- Card 4: Eagle Eye -->
        <a href="/services/security-cameras" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(0.6deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><ellipse cx="24" cy="24" rx="18" ry="12" fill="none" stroke="var(--navy)" stroke-width="2"/><circle cx="24" cy="24" r="7" fill="var(--red)" stroke="var(--navy)" stroke-width="2"/><circle cx="24" cy="24" r="3" fill="var(--navy)"/><path d="M4 24S14 10 24 10s20 14 20 14S34 38 24 38 4 24 4 24z" fill="none" stroke="var(--navy)" stroke-width="2"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">EAGLE EYE</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            Professional installation, live monitoring dashboards, and ongoing maintenance. We design systems that keep your building secure without compromising student privacy.
          </p>
        </a>

        <!-- Card 5: E-Rate Mastery -->
        <a href="/schools" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(0.4deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><rect x="6" y="8" width="36" height="32" rx="2" fill="var(--yellow)" stroke="var(--navy)" stroke-width="2"/><path d="M14 18h20M14 24h16M14 30h12" stroke="var(--navy)" stroke-width="2" stroke-linecap="round"/><circle cx="38" cy="36" r="8" fill="var(--red)" stroke="var(--navy)" stroke-width="2"/><path d="M35 36h6M38 33v6" stroke="var(--white)" stroke-width="2" stroke-linecap="round"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">E-RATE MASTERY</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            We navigate the full E-Rate lifecycle so your school gets maximum reimbursement. Applications, compliance, vendor coordination &mdash; handled.
          </p>
        </a>

        <!-- Card 6: Phase 0 Onboarding -->
        <a href="/about" class="comic-card animate-in" style="text-decoration:none; color:var(--navy); transform:rotate(-0.7deg);">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" style="margin-bottom:16px;"><path d="M24 4C13 4 4 13 4 24s9 20 20 20 20-9 20-20S35 4 24 4z" fill="none" stroke="var(--navy)" stroke-width="2"/><path d="M24 4C13 4 4 13 4 24s9 20 20 20" stroke="var(--red)" stroke-width="3" stroke-linecap="round"/><circle cx="24" cy="24" r="4" fill="var(--yellow)" stroke="var(--navy)" stroke-width="2"/><path d="M24 14v6M24 28v6" stroke="var(--navy)" stroke-width="2" stroke-linecap="round"/></svg>
          <h3 style="font-size:1.6rem; margin-bottom:12px; color:var(--navy);">PHASE 0 ONBOARDING</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.7; color:#444;">
            Before any contract starts, we embed with your current IT &mdash; learning your systems, your staff, your pain points. No cost, no commitment. Just making sure it's the right fit.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- =============================== -->
  <!-- HERO STATS (Red Diagonal)       -->
  <!-- =============================== -->
  <section class="clip-diagonal-both" style="background:var(--red); padding:120px 24px; position:relative;">
    <div class="halftone-light" style="position:absolute; inset:0;"></div>

    <div class="container-comic" style="position:relative; z-index:1;">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:40px; text-align:center; max-width:1000px; margin:0 auto;">
        <div class="animate-in">
          <div style="font-size:1.2rem; color:var(--yellow); font-family:'Bangers',cursive; letter-spacing:0.08em; margin-bottom:8px;">POWER</div>
          <div style="font-size:clamp(3rem, 6vw, 4.5rem); font-family:'Bangers',cursive; color:var(--white); text-shadow:3px 3px 0px rgba(0,0,0,0.3); line-height:1;">99.9%</div>
          <div style="font-family:'Poppins',sans-serif; color:rgba(255,255,255,0.9); font-size:0.95rem; margin-top:8px;">Network Uptime</div>
        </div>
        <div class="animate-in">
          <div style="font-size:1.2rem; color:var(--yellow); font-family:'Bangers',cursive; letter-spacing:0.08em; margin-bottom:8px;">SPEED</div>
          <div style="font-size:clamp(3rem, 6vw, 4.5rem); font-family:'Bangers',cursive; color:var(--white); text-shadow:3px 3px 0px rgba(0,0,0,0.3); line-height:1;">30 Min</div>
          <div style="font-family:'Poppins',sans-serif; color:rgba(255,255,255,0.9); font-size:0.95rem; margin-top:8px;">Critical Response Time</div>
        </div>
        <div class="animate-in">
          <div style="font-size:1.2rem; color:var(--yellow); font-family:'Bangers',cursive; letter-spacing:0.08em; margin-bottom:8px;">SHIELD</div>
          <div style="font-size:clamp(3rem, 6vw, 4.5rem); font-family:'Bangers',cursive; color:var(--white); text-shadow:3px 3px 0px rgba(0,0,0,0.3); line-height:1;">24/7</div>
          <div style="font-family:'Poppins',sans-serif; color:rgba(255,255,255,0.9); font-size:0.95rem; margin-top:8px;">Network Monitoring</div>
        </div>
        <div class="animate-in">
          <div style="font-size:1.2rem; color:var(--yellow); font-family:'Bangers',cursive; letter-spacing:0.08em; margin-bottom:8px;">XP</div>
          <div style="font-size:clamp(3rem, 6vw, 4.5rem); font-family:'Bangers',cursive; color:var(--white); text-shadow:3px 3px 0px rgba(0,0,0,0.3); line-height:1;">6+</div>
          <div style="font-family:'Poppins',sans-serif; color:rgba(255,255,255,0.9); font-size:0.95rem; margin-top:8px;">Years Protecting Schools</div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================== -->
  <!-- E-RATE SECTION                  -->
  <!-- =============================== -->
  <section class="clip-diagonal-top" style="background:var(--navy); padding:140px 24px 100px; position:relative;">
    <div class="halftone-light" style="position:absolute; inset:0;"></div>
    <div style="position:absolute; inset:0; opacity:0.03; background:repeating-linear-gradient(45deg, transparent, transparent 10px, var(--white) 10px, var(--white) 12px);" aria-hidden="true"></div>

    <div class="container-comic" style="position:relative; z-index:1;">
      <div style="text-align:center; margin-bottom:48px;">
        <h2 class="animate-in" style="font-size:clamp(2rem, 5vw, 3.2rem); color:var(--white);">
          STOP LEAVING <span class="highlight">MONEY</span> ON THE TABLE
        </h2>
        <p class="animate-in" style="font-family:'Bangers',cursive; color:var(--yellow); font-size:1.3rem; letter-spacing:0.04em; margin-top:8px;">
          Your Secret Weapon for Funding
        </p>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; max-width:1100px; margin:0 auto;">
        <div>
          <p class="animate-in" style="color:rgba(255,255,255,0.85); font-size:1.05rem; line-height:1.75; margin-bottom:32px;">
            E-Rate can cover up to 90% of your network support costs. Most schools know it exists &mdash; we guide you through it.
          </p>

          <ul class="animate-in" style="list-style:none; padding:0; margin:0 0 40px;">
            <li style="display:flex; align-items:center; gap:12px; margin-bottom:14px; color:var(--white); font-size:0.95rem;">
              <span style="color:var(--yellow); font-size:1.2rem; font-weight:bold;">&#10003;</span> Eligibility assessment
            </li>
            <li style="display:flex; align-items:center; gap:12px; margin-bottom:14px; color:var(--white); font-size:0.95rem;">
              <span style="color:var(--yellow); font-size:1.2rem; font-weight:bold;">&#10003;</span> Application preparation
            </li>
            <li style="display:flex; align-items:center; gap:12px; margin-bottom:14px; color:var(--white); font-size:0.95rem;">
              <span style="color:var(--yellow); font-size:1.2rem; font-weight:bold;">&#10003;</span> Vendor coordination
            </li>
            <li style="display:flex; align-items:center; gap:12px; margin-bottom:14px; color:var(--white); font-size:0.95rem;">
              <span style="color:var(--yellow); font-size:1.2rem; font-weight:bold;">&#10003;</span> Compliance documentation
            </li>
            <li style="display:flex; align-items:center; gap:12px; color:var(--white); font-size:0.95rem;">
              <span style="color:var(--yellow); font-size:1.2rem; font-weight:bold;">&#10003;</span> Cost optimization
            </li>
          </ul>

          <a href="/contact" class="btn-comic btn-comic-yellow animate-in">START YOUR E-RATE AUDIT</a>
        </div>

        <div class="animate-in">
          <div style="border:3px solid rgba(255,255,255,0.3); box-shadow:6px 6px 0px rgba(0,0,0,0.3); overflow:hidden; transform:rotate(1.5deg);">
            <img src="/images/school-classroom-alt.jpg" alt="Students in a school classroom" width="1210" height="911" loading="lazy" decoding="async" style="width:100%; height:auto; display:block;" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Page-scoped styles: hero flyer + section slants + responsive overrides -->
  <style>
    /* Slanted section separators — match the schools.astro pattern so the transition
       between the hero and the core message band reads as a deliberate diagonal
       rather than a broken clip-path gap. */
    .hero-slant-bottom {
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 60px;
      background: var(--white);
      clip-path: polygon(0 100%, 100% 100%, 100% 0);
      z-index: 4;
      pointer-events: none;
    }
    .core-message-slant-top {
      position: absolute;
      top: -1px;
      left: 0;
      right: 0;
      height: 50px;
      background: var(--white);
      clip-path: polygon(0 0, 100% 0, 0 100%);
      z-index: 1;
      pointer-events: none;
    }
    .core-message-slant-bottom {
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 50px;
      background: var(--gray-light);
      clip-path: polygon(100% 0, 0 100%, 100% 100%);
      z-index: 1;
      pointer-events: none;
    }

    /* Hero flying superhero */
    .hero-flyer {
      position: absolute;
      top: 38%;
      right: 4%;
      width: min(44vw, 520px);
      z-index: 5;
      pointer-events: none;
    }
    .hero-flyer-fly {
      animation: heroFlyIn 1.4s cubic-bezier(0.2, 0.75, 0.25, 1) both;
      animation-delay: 0.15s;
    }
    .hero-flyer-scroll {
      transform: translate3d(var(--scroll-x, 0px), var(--scroll-y, 0px), 0) rotate(var(--scroll-r, 0deg));
      transform-origin: 50% 50%;
      will-change: transform;
    }
    .hero-flyer-svg {
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(5px 5px 0 rgba(0, 0, 0, 0.35));
    }

    @keyframes heroFlyIn {
      0% {
        transform: translate3d(-130vw, 60vh, 0) rotate(-22deg) scale(0.82);
        opacity: 0;
      }
      35% {
        opacity: 1;
      }
      100% {
        transform: translate3d(0, 0, 0) rotate(-5deg) scale(1);
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-flyer-fly {
        animation: none;
        transform: rotate(-5deg);
      }
      .hero-flyer-scroll {
        transform: none !important;
      }
    }

    /* Tablet: smaller + off to the side, still visible behind text */
    @media (max-width: 1024px) {
      .hero-flyer {
        width: 52vw;
        top: 42%;
        right: -4%;
        opacity: 0.55;
      }
    }

    /* Mobile: hide — the figure overlaps the centered copy too aggressively */
    @media (max-width: 900px) {
      .hero-flyer { display: none; }
    }

    /* E-Rate section responsive override */
    @media (max-width: 768px) {
      .clip-diagonal-top .container-comic > div {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <!-- =============================== -->
  <!-- ORIGIN STORY                    -->
  <!-- =============================== -->
  <section id="origin" style="padding:100px 24px; background:var(--gray-light); position:relative;">
    <div class="halftone" style="position:absolute; inset:0;"></div>

    <div class="container-comic" style="position:relative; z-index:1;">
      <div style="text-align:center; margin-bottom:64px;">
        <h2 class="animate-in" style="font-size:clamp(2.2rem, 5vw, 3.5rem); color:var(--navy);">OUR <span class="highlight">ORIGIN</span> STORY</h2>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:32px; max-width:1100px; margin:0 auto;">
        <!-- Panel 1 -->
        <div class="comic-card animate-in" style="transform:rotate(-0.8deg); position:relative;">
          <div style="position:absolute; top:-14px; left:24px; background:var(--red); color:var(--white); font-family:'Bangers',cursive; padding:6px 16px; border:2px solid var(--navy); font-size:0.9rem; letter-spacing:0.06em;">PANEL 1</div>
          <h3 style="font-size:1.5rem; color:var(--red); margin-bottom:16px; margin-top:16px;">THE PROBLEM</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.75; color:#444;">
            Most IT companies serve anyone who'll sign a contract. Law firms, dental offices, whoever's next in line. Schools get lumped in with the rest &mdash; generic solutions, slow response, technicians who've never set foot in a classroom.
          </p>
        </div>

        <!-- Panel 2 -->
        <div class="comic-card animate-in" style="transform:rotate(0.5deg); position:relative;">
          <div style="position:absolute; top:-14px; left:24px; background:var(--yellow); color:var(--navy); font-family:'Bangers',cursive; padding:6px 16px; border:2px solid var(--navy); font-size:0.9rem; letter-spacing:0.06em;">PANEL 2</div>
          <h3 style="font-size:1.5rem; color:var(--navy); margin-bottom:16px; margin-top:16px;">THE CALL</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.75; color:#444;">
            We built Umbrella Systems because we think that's backwards. Schools have unique challenges &mdash; hundreds of student devices, state-mandated testing, E-Rate funding that saves tens of thousands if someone does the paperwork.
          </p>
        </div>

        <!-- Panel 3 -->
        <div class="comic-card animate-in" style="transform:rotate(-0.3deg); position:relative;">
          <div style="position:absolute; top:-14px; left:24px; background:var(--navy); color:var(--white); font-family:'Bangers',cursive; padding:6px 16px; border:2px solid var(--navy); font-size:0.9rem; letter-spacing:0.06em;">PANEL 3</div>
          <h3 style="font-size:1.5rem; color:var(--navy); margin-bottom:16px; margin-top:16px;">THE RESULT</h3>
          <p style="font-family:'Poppins',sans-serif; font-size:0.95rem; line-height:1.75; color:#444;">
            Schools that focus on students, not troubleshooting. A consistent team in your building who knows your staff by name. Technology that quietly enables the work instead of creating friction.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================== -->
  <!-- TESTIMONIAL                     -->
  <!-- =============================== -->
