---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import HearthNote from '../components/ui/HearthNote.astro';
import CheckIcon from '../components/ui/CheckIcon.astro';
---

<BaseLayout
  title="IT Support for Minnesota Charter Schools | Umbrella Systems"
  description="IT support built for charter schools. E-Rate eligible network services, dedicated on-site technicians, unlimited remote support, and full device management across Minnesota."
>
  <!-- Hero Section -->
  <section class="relative px-6 lg:px-8 py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="relative z-10">
        <span class="inline-block px-4 py-1.5 bg-secondary-container text-secondary text-xs font-bold rounded-full mb-6 uppercase tracking-widest">Serving Minnesota Schools Statewide</span>
        <h1 class="font-extrabold text-4xl lg:text-6xl leading-[1.1] text-on-surface mb-8">
          IT built for the way charter schools actually work.
        </h1>
        <p class="text-lg text-on-surface-variant max-w-lg mb-10 leading-relaxed">
          You don't need another vendor. You need a team that understands E-Rate deadlines, MCA testing requirements, and what happens when 400 students open Chromebooks at 8 AM.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/contact">Schedule a Conversation</Button>
          <Button variant="secondary" href="/about">Meet Our Team</Button>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] bg-surface-container-high rounded-xl overflow-hidden shadow-2xl rotate-2 relative">
          <img src="/images/staff-group.jpg" alt="School staff group photo with Umbrella Systems team member" class="w-full h-full object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- E-Rate Stats Banner -->
  <section class="bg-surface-container-low py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="bg-primary text-on-primary rounded-[2.5rem] p-10 lg:p-16 flex flex-col md:flex-row items-center justify-between gap-12 shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full blur-3xl -mr-32 -mt-32"></div>
        </div>
        <div class="relative z-10 grid grid-cols-1 sm:grid-cols-3 gap-8 w-full text-center">
          <div>
            <div class="text-5xl lg:text-6xl font-extrabold mb-2">Up to 90%</div>
            <div class="text-lg font-medium opacity-90">E-Rate reimbursement on network services</div>
          </div>
          <div>
            <div class="text-5xl lg:text-6xl font-extrabold mb-2">$0</div>
            <div class="text-lg font-medium opacity-90">Phase 0 onboarding cost</div>
          </div>
          <div>
            <div class="text-5xl lg:text-6xl font-extrabold mb-2">100%</div>
            <div class="text-lg font-medium opacity-90">E-Rate paperwork handled by us</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- E-Rate Split Section -->
  <section class="py-20 lg:py-24 px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-extrabold mb-4">How the funding works.</h2>
        <p class="text-on-surface-variant text-lg max-w-3xl mx-auto">E-Rate is a federal program that reimburses schools for eligible network and infrastructure costs. The key word is "eligible" — not everything qualifies. Here's how we structure it so your school gets the maximum benefit.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Network Support - E-Rate Eligible -->
        <div class="bg-surface-container rounded-xl p-8 lg:p-10 border-t-8 border-primary">
          <span class="inline-block bg-tertiary text-on-tertiary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-6">E-Rate Eligible</span>
          <h3 class="text-2xl font-extrabold mb-4">Network & Infrastructure Support</h3>
          <p class="text-on-surface-variant mb-6 leading-relaxed">This is the piece E-Rate covers. Depending on your school's reimbursement rate (typically 50-90%), the federal program pays most of this cost directly.</p>
          <p class="font-bold text-sm uppercase tracking-wider text-secondary mb-3">Includes:</p>
          <ul class="space-y-2 text-on-surface-variant text-sm">
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />24/7 network monitoring and proactive alert response</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />Firewall, router, switch, and access point management</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />Security updates and patch management</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />Wireless optimization and performance tuning</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />Data backup and disaster recovery planning</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />Google Admin Console network-level support</li>
          </ul>
          <p class="mt-6 text-primary font-bold">Your cost after E-Rate: As low as 10% of the monthly rate.</p>
        </div>

        <!-- On-Site Support - School Funded -->
        <div class="bg-surface-container rounded-xl p-8 lg:p-10 border-t-8 border-secondary">
          <span class="inline-block bg-secondary text-on-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-6">School Funded</span>
          <h3 class="text-2xl font-extrabold mb-4">On-Site & Remote Support</h3>
          <p class="text-on-surface-variant mb-6 leading-relaxed">This covers the day-to-day, hands-on support that keeps your staff and students productive. E-Rate doesn't cover it, but it's where most of the visible value lives.</p>
          <p class="font-bold text-sm uppercase tracking-wider text-secondary mb-3">Includes:</p>
          <ul class="space-y-2 text-on-surface-variant text-sm">
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Dedicated on-site technician (1-5 days/week)</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Unlimited remote helpdesk — no ticket limits</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Device management: Chromebooks, laptops, tablets</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Identity and access management</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Testing support for MCA, FastBridge, ACCESS</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Security camera maintenance</li>
            <li class="flex items-start gap-2"><CheckIcon class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" />Hardware procurement coordination</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Target Profile Section -->
  <section class="bg-surface-container-low py-20 lg:py-24 px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-16 gap-8">
        <div class="max-w-2xl">
          <h2 class="text-3xl lg:text-4xl font-extrabold mb-4">Who we work best with.</h2>
          <p class="text-on-surface-variant text-lg leading-relaxed">We partner with Minnesota charter schools ranging from about 200 to 1,500 students. Our sweet spot is 300-600 students — large enough to need real IT infrastructure, small enough that we can know every teacher by name.</p>
        </div>
        <HearthNote class="max-w-xs">
          <p class="italic text-sm text-on-surface">We find that schools with 200-1500 students get the most value from our embedded support model.</p>
        </HearthNote>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 bg-surface-container-lowest rounded-xl p-8 lg:p-10 border border-outline-variant/15">
          <h3 class="text-2xl font-bold mb-4">What our partner schools have in common:</h3>
          <ul class="space-y-3 text-on-surface-variant">
            <li class="flex items-start gap-3"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />They've outgrown the "one tech-savvy teacher" approach</li>
            <li class="flex items-start gap-3"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />They want proactive IT management, not just break-fix</li>
            <li class="flex items-start gap-3"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />They care about E-Rate optimization and cost predictability</li>
            <li class="flex items-start gap-3"><CheckIcon class="w-5 h-5 text-tertiary flex-shrink-0 mt-0.5" />They want their IT team to feel like part of the school community</li>
          </ul>
        </div>
        <div class="bg-secondary text-on-secondary rounded-xl p-10 flex flex-col justify-center text-center">
          <span class="text-5xl font-extrabold mb-2">200-1,500</span>
          <p class="text-xl opacity-90 font-bold">Student Population</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 lg:py-24 px-6 lg:px-8 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl lg:text-5xl font-extrabold mb-8">Let's figure out if we're a fit.</h2>
      <p class="text-xl text-on-surface-variant mb-12 max-w-2xl mx-auto">We'll walk through your current setup, talk about what's working and what isn't, and show you exactly how we'd structure support for your school — including E-Rate projections.</p>
      <Button href="/contact">Schedule a Conversation</Button>
    </div>
  </section>
</BaseLayout>
