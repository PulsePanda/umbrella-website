---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="vCIO & IT Leadership for Schools | Strategic Vision | Umbrella Systems"
  description="Strategic IT leadership for schools. vCIO services, E-Rate optimization, hardware procurement, compliance oversight, and long-term technology planning."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="halftone"></div>
    <div class="container-comic hero-grid">
      <div class="hero-content animate-in">
        <span class="hero-icon">&#129504;</span>
        <h1 class="hero-title text-shadow-comic">
          STRATEGIC IT <span class="highlight">LEADERSHIP</span> WITHOUT THE EXECUTIVE PRICE TAG
        </h1>
        <p class="hero-sub">
          Technology planning, procurement strategy, E-Rate optimization, compliance oversight. The vCIO services your school needs — embedded in a team that already knows your environment.
        </p>
        <div class="hero-ctas">
          <a href="/contact" class="btn-comic btn-comic-red">Schedule a Strategy Session</a>
          <a href="/services/managed-it" class="btn-comic btn-comic-yellow">Managed IT Services</a>
        </div>
      </div>
      <div class="hero-image-wrap animate-in" data-delay="200">
        <div class="comic-panel hero-panel">
          <img src="/images/it-office-monitoring.jpg" alt="IT leadership and monitoring station at Umbrella Systems" loading="eager" />
        </div>
      </div>
    </div>
    <div class="clip-edge"></div>
  </section>

  <!-- Strategic Framework -->
  <section class="framework-section">
    <div class="halftone-bg"></div>
    <div class="container-comic">
      <h2 class="section-title animate-in">WHAT STRATEGIC IT LEADERSHIP INCLUDES</h2>
      <div class="framework-grid">
        <div class="comic-card framework-card framework-card-featured animate-in">
          <span class="card-icon">&#128202;</span>
          <h3 class="card-title">vCIO SERVICES</h3>
          <p class="card-text">Long-term tech planning aligned with your school's goals and budget. Real conversations about real decisions — no jargon-filled reports.</p>
          <div class="card-accent"></div>
        </div>
        <div class="comic-card framework-card animate-in" data-delay="100">
          <span class="card-icon">&#128722;</span>
          <h3 class="card-title">HARDWARE PROCUREMENT</h3>
          <p class="card-text">We don't sell hardware and we don't mark up prices. We get you competitive quotes from Ubiquiti, HP, Cisco. You buy direct at the best price.</p>
        </div>
        <div class="comic-card framework-card animate-in" data-delay="200">
          <span class="card-icon">&#128176;</span>
          <h3 class="card-title">E-RATE OPTIMIZATION</h3>
          <p class="card-text">We manage the full E-Rate lifecycle. Schools we work with have collectively saved six figures — money that goes back into classrooms.</p>
          <div class="card-stat">
            <span class="stat-highlight">6 Figures+</span>
            <span class="stat-caption">Saved Collectively</span>
          </div>
        </div>
        <div class="comic-card framework-card animate-in" data-delay="100">
          <span class="card-icon">&#128274;</span>
          <h3 class="card-title">APP & SOFTWARE SECURITY REVIEW</h3>
          <p class="card-text">Before a new app touches your network or student data, we review it. FERPA, COPPA, Minnesota privacy. Clear recommendation: approve, restrict, or reject.</p>
        </div>
        <div class="comic-card framework-card animate-in" data-delay="200">
          <span class="card-icon">&#129309;</span>
          <h3 class="card-title">PHASE 0 ONBOARDING</h3>
          <p class="card-text">Before any contract, we embed with your current IT setup at no cost. We learn your systems, your workflows, your pain points from the inside.</p>
          <div class="card-badge">No Cost to Start</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Break Projects -->
  <section class="breaks-section">
    <div class="halftone-light-bg"></div>
    <div class="container-comic">
      <h2 class="section-title section-title-light animate-in">BIG PROJECTS, BUILT FOR BREAKS</h2>
      <p class="breaks-sub animate-in" data-delay="100">Some work is too disruptive for the school year.</p>
      <div class="breaks-grid">
        <div class="breaks-panel animate-in" data-delay="100">
          <div class="panel-number" aria-hidden="true">01</div>
          <h3 class="panel-title">INFRASTRUCTURE AUDITS</h3>
          <p class="panel-text">Hardware, software, network, security evaluation. A full assessment of where you stand and what needs attention.</p>
        </div>
        <div class="breaks-panel breaks-panel-image animate-in" data-delay="200">
          <div class="panel-image">
            <img src="/images/summer-project.jpg" alt="Umbrella Systems team working on a summer infrastructure project" loading="lazy" />
          </div>
          <div class="panel-content">
            <div class="panel-number" aria-hidden="true">02</div>
            <h3 class="panel-title">MASS DEVICE DEPLOYMENT</h3>
            <p class="panel-text">Fleet-wide Chromebook rollouts, configured and enrolled. Hundreds of devices ready for day one.</p>
          </div>
        </div>
        <div class="breaks-panel animate-in" data-delay="300">
          <div class="panel-number" aria-hidden="true">03</div>
          <h3 class="panel-title">LONG-TERM PLANNING</h3>
          <p class="panel-text">Multi-year roadmaps for enrollment growth, infrastructure aging, and technology refresh cycles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container-comic cta-inner">
      <h2 class="cta-title animate-in">GET A STRATEGIC PARTNER, NOT JUST A VENDOR</h2>
      <p class="cta-sub animate-in" data-delay="100">We'll sit down with your leadership team, learn what's working and what isn't, and build a technology roadmap that actually makes sense for your school.</p>
      <a href="/contact" class="btn-comic btn-comic-white animate-in" data-delay="200">Schedule a Strategy Session</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================== */
  /* Hero                           */
  /* ============================== */
  .hero-section {
    background: var(--navy);
    color: var(--white);
    padding: 250px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-section .halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: 3.2rem;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.7;
    opacity: 0.9;
    max-width: 560px;
    margin-bottom: 32px;
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .comic-panel {
    border: var(--border-comic);
    box-shadow: 6px 6px 0 rgba(255,255,255,0.15);
    overflow: hidden;
    background: var(--navy);
  }
  .hero-panel {
    transform: rotate(-2deg);
    aspect-ratio: 4/3;
  }
  .hero-panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .clip-edge {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--white);
    clip-path: polygon(0 60%, 100% 0, 100% 100%, 0 100%);
  }

  /* ============================== */
  /* Strategic Framework            */
  /* ============================== */
  .framework-section {
    padding: 100px 0;
    position: relative;
    background: var(--white);
  }
  .halftone-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--navy) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.03;
    pointer-events: none;
  }
  .section-title {
    font-size: 2.8rem;
    text-align: center;
    margin-bottom: 60px;
    position: relative;
  }
  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 5px;
    background: var(--yellow);
    margin: 16px auto 0;
    border: 2px solid var(--navy);
  }
  .framework-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .framework-card {
    padding: 36px;
    position: relative;
  }
  .framework-card-featured {
    grid-column: span 3;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    background: linear-gradient(135deg, var(--white) 0%, #fafafa 100%);
  }
  .framework-card-featured .card-accent {
    width: 6px;
    height: 80%;
    background: var(--yellow);
    border: 2px solid var(--navy);
    align-self: center;
  }
  .framework-card:nth-child(2) { transform: rotate(-0.5deg); }
  .framework-card:nth-child(3) { transform: rotate(0.5deg); }
  .framework-card:nth-child(4) { transform: rotate(0.5deg); }
  .framework-card:nth-child(5) { transform: rotate(-0.5deg); }
  .card-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 12px;
  }
  .card-title {
    font-size: 1.5rem;
    margin-bottom: 12px;
    color: var(--navy);
  }
  .card-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #444;
  }
  .card-badge {
    display: inline-block;
    margin-top: 16px;
    padding: 6px 16px;
    background: var(--yellow);
    border: 2px solid var(--navy);
    font-family: 'Bangers', cursive;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .card-stat {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 2px dashed var(--navy);
  }
  .stat-highlight {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: 1.8rem;
    color: var(--red);
    letter-spacing: 0.04em;
  }
  .stat-caption {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666;
  }

  /* ============================== */
  /* Break Projects                 */
  /* ============================== */
  .breaks-section {
    background: var(--red);
    color: var(--white);
    padding: 100px 0;
    position: relative;
    clip-path: polygon(0 4%, 100% 0, 100% 96%, 0 100%);
    overflow: hidden;
  }
  .halftone-light-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .section-title-light {
    color: var(--white);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .section-title-light::after {
    background: var(--yellow);
    border-color: var(--navy);
  }
  .breaks-sub {
    text-align: center;
    font-size: 1.15rem;
    opacity: 0.95;
    margin-top: -40px;
    margin-bottom: 48px;
  }
  .breaks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .breaks-panel {
    background: rgba(255,255,255,0.1);
    border: 3px solid rgba(255,255,255,0.25);
    padding: 36px 28px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .breaks-panel:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
  }
  .breaks-panel-image {
    padding: 0;
    overflow: hidden;
  }
  .panel-image {
    height: 160px;
    overflow: hidden;
  }
  .panel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .panel-content {
    padding: 28px;
  }
  .panel-number {
    font-family: 'Bangers', cursive;
    font-size: 2.4rem;
    color: var(--yellow);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
    margin-bottom: 8px;
    letter-spacing: 0.06em;
  }
  .panel-title {
    font-size: 1.4rem;
    margin-bottom: 12px;
    letter-spacing: 0.06em;
  }
  .panel-text {
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* ============================== */
  /* CTA                            */
  /* ============================== */
  .cta-section {
    background: var(--navy);
    color: var(--white);
    padding: 100px 0;
    text-align: center;
  }
  .cta-title {
    font-size: 2.8rem;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.4);
  }
  .cta-sub {
    font-size: 1.15rem;
    max-width: 640px;
    margin: 0 auto 36px;
    opacity: 0.9;
    line-height: 1.7;
  }

  /* ============================== */
  /* Responsive                     */
  /* ============================== */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-title {
      font-size: 2.4rem;
    }
    .framework-card-featured {
      grid-column: span 1;
      display: block;
    }
    .framework-card-featured .card-accent {
      display: none;
    }
    .framework-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .breaks-grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin: 0 auto;
    }
  }
  @media (max-width: 768px) {
    .hero-section {
      padding: 200px 0 80px;
    }
    .hero-title {
      font-size: 2rem;
    }
    .section-title {
      font-size: 2rem;
    }
    .framework-grid {
      grid-template-columns: 1fr;
    }
    .breaks-section {
      clip-path: polygon(0 2%, 100% 0, 100% 98%, 0 100%);
    }
    .cta-title {
      font-size: 2rem;
    }
  }
</style>
