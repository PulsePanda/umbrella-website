---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="School Network & E-Rate Services | Fortress Network | Umbrella Systems"
  description="E-Rate eligible network services for schools. 24/7 monitoring, wireless optimization, firewall management, disaster recovery, and 99.9% uptime commitment."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="halftone"></div>
    <div class="container-comic hero-grid">
      <div class="hero-content animate-in">
        <h1 class="hero-title text-shadow-comic">
          A NETWORK YOUR SCHOOL CAN ACTUALLY <span class="highlight">RELY ON</span>
        </h1>
        <div class="starburst hero-starburst">99.9% Uptime Commitment</div>
        <p class="hero-sub">
          24/7 monitoring, proactive maintenance, and the infrastructure expertise to keep hundreds of devices connected — all day, every day.
        </p>
        <div class="hero-ctas">
          <a href="/contact" class="btn-comic btn-comic-red">Request a Network Assessment</a>
          <a href="#erate" class="btn-comic btn-comic-yellow">E-Rate Info</a>
        </div>
      </div>
      <div class="hero-image-wrap animate-in" data-delay="200">
        <div class="comic-panel hero-panel">
          <img src="/images/network-rack-clean.jpg" alt="Clean, professionally organized network rack at a school" width="683" height="911" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <div class="comic-panel hero-panel-small">
          <img src="/images/server-room-1.jpg" alt="Server room infrastructure managed by Umbrella Systems" width="1200" height="1600" loading="eager" decoding="async" />
        </div>
      </div>
    </div>
    <div class="clip-edge"></div>
  </section>

  <!-- E-Rate Banner -->
  <section class="erate-banner" id="erate">
    <div class="container-comic erate-inner">
      <div class="erate-badge-col">
        <div class="erate-shield" aria-hidden="true">
          <span>E</span>
        </div>
      </div>
      <div class="erate-text">
        <h2 class="erate-headline">E-RATE CERTIFIED PROVIDER</h2>
        <p class="erate-sub">Our network services are structured for maximum E-Rate reimbursement. We handle the applications, the compliance documentation, and the vendor coordination. Your school gets enterprise-grade infrastructure at a fraction of the cost.</p>
        <a href="/erate-audit" class="btn-comic btn-comic-yellow" style="margin-top:1.25rem;">Run Your Free E-Rate Audit</a>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="services-section">
    <div class="halftone-bg"></div>
    <div class="container-comic">
      <h2 class="section-title animate-in">WHAT WE MONITOR, MANAGE, AND PROTECT</h2>
      <div class="services-grid">
        <div class="comic-card service-card animate-in">
          <div class="service-card-image">
            <img src="/images/security-camera-2.jpg" alt="Ceiling-mounted networking hardware in a school" width="1200" height="1600" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <span class="card-icon">&#128225;</span>
            <h3 class="card-title">WIRELESS OPTIMIZATION</h3>
            <p class="card-text">Reliable Wi-Fi across every classroom, gym, and common area. When 400 students open their Chromebooks at the same time, everything just works.</p>
          </div>
        </div>
        <div class="comic-card service-card animate-in" data-delay="100">
          <div class="service-card-image">
            <img src="/images/security-dashboard.jpg" alt="Network monitoring dashboard tracking health and alerts" width="1600" height="896" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <span class="card-icon">&#128269;</span>
            <h3 class="card-title">24/7 MONITORING</h3>
            <p class="card-text">We don't wait for someone to report a problem. Our monitoring tracks network health around the clock, alerting us to issues before they affect your classrooms.</p>
          </div>
        </div>
        <div class="comic-card service-card animate-in" data-delay="200">
          <div class="service-card-image">
            <img src="/images/network-closet-cabling.jpg" alt="Organized network closet cabling installation" width="683" height="911" loading="lazy" decoding="async" />
          </div>
          <div class="service-card-body">
            <span class="card-icon">&#128737;</span>
            <h3 class="card-title">FIREWALL & CYBERSECURITY</h3>
            <p class="card-text">Firewall config, intrusion detection, content filtering, security policy enforcement. Every change follows a structured process.</p>
          </div>
        </div>
        <div class="comic-card service-card animate-in" data-delay="300">
          <div class="service-card-body">
            <span class="card-icon">&#128190;</span>
            <h3 class="card-title">DISASTER RECOVERY</h3>
            <p class="card-text">Scheduled backups, recovery planning, redundancy for Google Workspace, Microsoft 365, and on-premise. We test it regularly so it works when you need it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance Section -->
  <section class="compliance-section">
    <div class="halftone-light-bg"></div>
    <div class="container-comic">
      <h2 class="section-title section-title-light animate-in">COMPLIANCE BUILT INTO EVERY LAYER</h2>
      <div class="compliance-grid">
        <div class="compliance-card animate-in">
          <h3 class="compliance-label">MN H.F. 2353</h3>
          <p class="compliance-text">Minnesota's student data privacy law. We ensure all systems handling student data meet state requirements for access controls, breach notification, and vendor agreements.</p>
        </div>
        <div class="compliance-card animate-in" data-delay="100">
          <h3 class="compliance-label">FERPA</h3>
          <p class="compliance-text">Federal education records protection. Network segmentation, access controls, and audit trails designed to keep student records secure and compliant.</p>
        </div>
        <div class="compliance-card animate-in" data-delay="200">
          <h3 class="compliance-label">COPPA</h3>
          <p class="compliance-text">Children's online privacy protection. Content filtering, app vetting, and data handling practices that meet federal requirements for students under 13.</p>
        </div>
        <div class="compliance-card animate-in" data-delay="300">
          <h3 class="compliance-label">CIPA</h3>
          <p class="compliance-text">Children's Internet Protection Act — required for E-Rate funding. We implement and maintain certified content filtering and internet safety policies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container-comic cta-inner">
      <h2 class="cta-title animate-in">LET'S TALK ABOUT YOUR NETWORK</h2>
      <p class="cta-sub animate-in" data-delay="100">Whether you're dealing with dead zones, aging infrastructure, or E-Rate applications, we'll assess your current setup and show you what's possible.</p>
      <a href="/contact" class="btn-comic btn-comic-white animate-in" data-delay="200">Request a Network Assessment</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================== */
  /* Hero                           */
  /* ============================== */
  .hero-section {
    background: var(--navy);
    color: var(--white);
    padding: 250px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-section .halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: 3.2rem;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .hero-starburst {
    margin-bottom: 20px;
  }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.7;
    opacity: 0.9;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .comic-panel {
    border: var(--border-comic);
    box-shadow: 6px 6px 0 rgba(255,255,255,0.15);
    overflow: hidden;
    background: var(--navy);
  }
  .hero-panel {
    transform: rotate(2deg);
    aspect-ratio: 4/3;
  }
  .hero-panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-panel-small {
    position: absolute;
    bottom: -20px;
    left: -30px;
    width: 200px;
    aspect-ratio: 4/3;
    transform: rotate(-3deg);
    z-index: 2;
  }
  .hero-panel-small img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-image-wrap {
    position: relative;
  }
  .clip-edge {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 60px;
    background: #366430;
    clip-path: polygon(0 60%, 100% 0, 100% 100%, 0 100%);
  }

  /* ============================== */
  /* E-Rate Banner                  */
  /* ============================== */
  .erate-banner {
    background: #366430;
    color: var(--white);
    padding: 80px 0 100px;
    position: relative;
    clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
  }
  .erate-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    text-align: center;
  }
  .erate-text {
    max-width: 720px;
  }
  .erate-shield {
    width: 80px;
    height: 80px;
    background: var(--yellow);
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bangers', cursive;
    font-size: 2.5rem;
    color: var(--navy);
    transform: rotate(-5deg);
    flex-shrink: 0;
  }
  .erate-headline {
    font-size: 2.4rem;
    margin-bottom: 12px;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .erate-sub {
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.95;
  }

  /* ============================== */
  /* Core Services                  */
  /* ============================== */
  .services-section {
    padding: 100px 0;
    position: relative;
    background: var(--white);
  }
  .halftone-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--navy) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.03;
    pointer-events: none;
  }
  .section-title {
    font-size: 2.8rem;
    text-align: center;
    margin-bottom: 60px;
    position: relative;
  }
  .section-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 5px;
    background: var(--yellow);
    margin: 16px auto 0;
    border: 2px solid var(--navy);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .service-card {
    padding: 0;
    overflow: hidden;
  }
  .service-card:nth-child(odd) {
    transform: rotate(-0.5deg);
  }
  .service-card:nth-child(even) {
    transform: rotate(0.5deg);
  }
  .service-card-image {
    height: 200px;
    overflow: hidden;
  }
  .service-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .service-card-body {
    padding: 32px;
  }
  .card-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 10px;
  }
  .card-title {
    font-size: 1.5rem;
    margin-bottom: 12px;
    color: var(--navy);
  }
  .card-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #444;
  }

  /* ============================== */
  /* Compliance                     */
  /* ============================== */
  .compliance-section {
    background: var(--navy);
    color: var(--white);
    padding: 100px 0;
    position: relative;
    clip-path: polygon(0 4%, 100% 0, 100% 96%, 0 100%);
    overflow: hidden;
  }
  .halftone-light-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .section-title-light {
    color: var(--white);
    text-shadow: 2px 2px 0 rgba(0,0,0,0.4);
  }
  .section-title-light::after {
    background: var(--red);
    border-color: var(--white);
  }
  .compliance-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .compliance-card {
    background: rgba(255,255,255,0.06);
    border: 2px solid rgba(255,255,255,0.15);
    padding: 28px 24px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .compliance-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.1);
  }
  .compliance-label {
    font-size: 1.4rem;
    color: var(--yellow);
    margin-bottom: 12px;
  }
  .compliance-text {
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.85;
  }
  /* ============================== */
  /* CTA                            */
  /* ============================== */
  .cta-section {
    background: var(--red);
    color: var(--white);
    padding: 100px 0;
    text-align: center;
  }
  .cta-title {
    font-size: 2.8rem;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .cta-sub {
    font-size: 1.15rem;
    max-width: 640px;
    margin: 0 auto 36px;
    opacity: 0.95;
    line-height: 1.7;
  }

  /* ============================== */
  /* Responsive                     */
  /* ============================== */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-title {
      font-size: 2.4rem;
    }
    .hero-panel-small {
      width: 150px;
      bottom: -10px;
      left: -15px;
    }
    .compliance-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .hero-section {
      padding: 200px 0 80px;
    }
    .hero-title {
      font-size: 2rem;
    }
    .erate-headline {
      font-size: 1.6rem;
    }
    .erate-banner {
      clip-path: polygon(0 0, 100% 0, 100% 95%, 0 100%);
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .section-title {
      font-size: 2rem;
    }
    .compliance-section {
      clip-path: polygon(0 2%, 100% 0, 100% 98%, 0 100%);
    }
    .compliance-grid {
      grid-template-columns: 1fr;
    }
    .cta-title {
      font-size: 2rem;
    }
  }
</style>
