---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sejong Academy Resource Hub | Umbrella Systems"
  description="IT resources and forms for Sejong Academy staff."
  noindex={true}
>
  <!-- Hero -->
  <section class="portal-hero">
    <div class="portal-hero-halftone"></div>
    <div class="portal-hero-inner">
      <div class="portal-hero-text animate-in">
        <span class="portal-badge">CLIENT PORTAL</span>
        <h1 class="portal-h1">SEJONG ACADEMY</h1>
        <p class="portal-sub">Your IT Resource Hub</p>
      </div>
    </div>
    <div class="portal-hero-clip"></div>
  </section>

  <!-- Forms Section -->
  <section class="portal-section">
    <div class="section-inner">
      <h2 class="portal-h2 animate-in">ONBOARDING & OFFBOARDING</h2>
      <p class="portal-section-desc animate-in" data-delay="1">Submit requests for new and departing students and staff.</p>
      <div class="portal-grid">
        <!-- Student Column -->
        <div class="portal-column animate-in" data-delay="1">
          <h3 class="portal-column-title">Students</h3>
          <a href="#" class="portal-card portal-card-green portal-card-placeholder">
            <div class="portal-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </div>
            <div class="portal-card-content">
              <span class="portal-card-title">Student Onboarding</span>
              <span class="portal-card-desc">Coming soon</span>
            </div>
          </a>
          <a href="#" class="portal-card portal-card-red portal-card-placeholder">
            <div class="portal-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="11" x2="23" y2="11"/></svg>
            </div>
            <div class="portal-card-content">
              <span class="portal-card-title">Student Offboarding</span>
              <span class="portal-card-desc">Coming soon</span>
            </div>
          </a>
        </div>
        <!-- Staff Column -->
        <div class="portal-column animate-in" data-delay="2">
          <h3 class="portal-column-title">Staff</h3>
          <a href="#" class="portal-card portal-card-green portal-card-placeholder">
            <div class="portal-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="15" y1="14" x2="9" y2="14"/></svg>
            </div>
            <div class="portal-card-content">
              <span class="portal-card-title">Staff Onboarding</span>
              <span class="portal-card-desc">Coming soon</span>
            </div>
          </a>
          <a href="#" class="portal-card portal-card-red portal-card-placeholder">
            <div class="portal-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
            </div>
            <div class="portal-card-content">
              <span class="portal-card-title">Staff Offboarding</span>
              <span class="portal-card-desc">Coming soon</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Section -->
  <section class="portal-section-alt">
    <div class="portal-section-alt-halftone"></div>
    <div class="portal-section-alt-clip-top"></div>
    <div class="section-inner portal-section-alt-inner">
      <h2 class="portal-h2 white animate-in">SUPPORT & HELP</h2>
      <p class="portal-section-desc-light animate-in" data-delay="1">Get help from the Umbrella team.</p>
      <div class="portal-support-grid">
        <a href="https://umbrellasystems.screenconnect.com/" target="_blank" rel="noopener noreferrer" class="portal-support-card animate-in" data-delay="1">
          <div class="portal-support-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <span class="portal-support-title">Remote Support Portal</span>
          <span class="portal-support-desc">Connect with a technician for remote assistance</span>
        </a>
        <a href="mailto:techsupport@sejongacademy.org" class="portal-support-card animate-in" data-delay="2">
          <div class="portal-support-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <span class="portal-support-title">Email Support</span>
          <span class="portal-support-desc">techsupport@sejongacademy.org</span>
        </a>
      </div>
    </div>
    <div class="portal-section-alt-clip-bottom"></div>
  </section>

  <!-- Footer CTA -->
  <section class="portal-cta">
    <div class="portal-cta-halftone"></div>
    <div class="section-inner portal-cta-inner">
      <h2 class="portal-h2 white animate-in">NEED HELP?</h2>
      <p class="portal-cta-desc animate-in" data-delay="1">Reach out to the Umbrella team anytime.</p>
      <div class="portal-cta-buttons animate-in" data-delay="2">
        <a href="tel:6514094321" class="comic-btn">Call 651-409-4321</a>
        <a href="mailto:techsupport@sejongacademy.org" class="comic-btn comic-btn-outline">Email Us</a>
      </div>
      <form method="POST" action="/api/school-login" class="portal-logout">
        <input type="hidden" name="school" value="sja" />
        <input type="hidden" name="action" value="logout" />
        <button type="submit" class="portal-logout-btn">Sign Out</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Poppins:wght@400;500;600;700&display=swap');

  :root {
    --navy: #1a1a2e;
    --red: #ff1744;
    --red-dark: #d50000;
    --yellow: #ffd600;
    --white: #ffffff;
    --gray: #9e9e9e;
    --shadow-comic: 4px 4px 0px var(--navy);
    --shadow-comic-sm: 3px 3px 0px var(--navy);
    --border-comic: 3px solid var(--navy);
  }

  .animate-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .animate-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .animate-in[data-delay="1"] { transition-delay: 0.15s; }
  .animate-in[data-delay="2"] { transition-delay: 0.3s; }
  .animate-in[data-delay="3"] { transition-delay: 0.45s; }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ---- HERO ---- */
  .portal-hero {
    position: relative;
    background: var(--navy);
    padding: 250px 0 5rem;
    overflow: hidden;
    text-align: center;
  }
  .portal-hero-halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 12px 12px;
    pointer-events: none;
  }
  .portal-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .portal-badge {
    display: inline-block;
    font-family: 'Bangers', cursive;
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: var(--navy);
    background: var(--yellow);
    padding: 6px 18px;
    border: var(--border-comic);
    box-shadow: var(--shadow-comic-sm);
    margin-bottom: 1.5rem;
  }
  .portal-h1 {
    font-family: 'Bangers', cursive;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    color: var(--white);
    letter-spacing: 3px;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }
  .portal-sub {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    color: rgba(255,255,255,0.8);
  }
  .portal-hero-clip {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--white);
    clip-path: polygon(0 100%, 100% 100%, 100% 0);
  }

  /* ---- SECTIONS ---- */
  .portal-section {
    padding: 5rem 0;
    background: var(--white);
  }
  .portal-h2 {
    font-family: 'Bangers', cursive;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--navy);
    letter-spacing: 2px;
    text-align: center;
    margin: 0 0 0.5rem;
  }
  .portal-h2.white { color: var(--white); }
  .portal-section-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    color: #666;
    text-align: center;
    margin: 0 auto 3rem;
    max-width: 500px;
  }
  .portal-section-desc-light {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
    text-align: center;
    margin: 0 auto 3rem;
    max-width: 500px;
  }

  /* ---- FORMS GRID ---- */
  .portal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .portal-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }
  .portal-column-title {
    font-family: 'Bangers', cursive;
    font-size: 1.4rem;
    color: var(--navy);
    letter-spacing: 2px;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px dashed var(--navy);
  }
  .portal-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 20px 24px;
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    text-decoration: none;
    color: var(--navy);
    background: var(--white);
    margin-bottom: 1rem;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .portal-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--navy);
  }
  .portal-card-placeholder {
    opacity: 0.5;
    pointer-events: none;
  }
  .portal-card-green { border-left: 6px solid #4caf50; }
  .portal-card-red { border-left: 6px solid var(--red); }
  .portal-card-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: var(--navy);
  }
  .portal-card-icon svg { width: 100%; height: 100%; }
  .portal-card-green .portal-card-icon { color: #2e7d32; }
  .portal-card-red .portal-card-icon { color: var(--red-dark); }
  .portal-card-content { flex: 1; }
  .portal-card-title {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: 1.15rem;
    letter-spacing: 1px;
  }
  .portal-card-desc {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-size: 0.8rem;
    color: #666;
    margin-top: 2px;
  }

  /* ---- SUPPORT SECTION ---- */
  .portal-section-alt {
    position: relative;
    background: var(--navy);
    padding: 6rem 0;
    overflow: hidden;
  }
  .portal-section-alt-halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 14px 14px;
    pointer-events: none;
  }
  .portal-section-alt-clip-top {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 50px;
    background: var(--white);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .portal-section-alt-clip-bottom {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 50px;
    background: var(--white);
    clip-path: polygon(0 0, 0 100%, 100% 100%);
  }
  .portal-section-alt-inner { position: relative; z-index: 2; }

  .portal-support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 800px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .portal-support-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .portal-support-card {
    background: var(--white);
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    padding: 28px 20px;
    text-align: center;
    text-decoration: none;
    color: var(--navy);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .portal-support-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--navy);
  }
  .portal-support-card-placeholder {
    opacity: 0.7;
    pointer-events: none;
  }
  .portal-support-card-placeholder.visible { opacity: 0.7; }
  .portal-support-icon {
    width: 32px;
    height: 32px;
    margin: 0 auto 12px;
    color: var(--red);
  }
  .portal-support-icon svg { width: 100%; height: 100%; }
  .portal-support-title {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: 1.05rem;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  .portal-support-desc {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-size: 0.8rem;
    color: #666;
  }

  /* ---- CTA ---- */
  .portal-cta {
    position: relative;
    background: var(--red);
    padding: 5rem 0;
    text-align: center;
    overflow: hidden;
  }
  .portal-cta-halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 10px 10px;
    pointer-events: none;
  }
  .portal-cta-inner { position: relative; z-index: 2; }
  .portal-cta-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    color: rgba(255,255,255,0.9);
    margin: 0.5rem auto 2rem;
  }
  .portal-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .comic-btn {
    display: inline-block;
    font-family: 'Bangers', cursive;
    font-size: 1.2rem;
    letter-spacing: 1.5px;
    color: var(--navy);
    background: var(--yellow);
    border: var(--border-comic);
    box-shadow: var(--shadow-comic);
    padding: 0.85rem 2rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .comic-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--navy);
  }
  .comic-btn-outline {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.3);
  }
  .comic-btn-outline:hover {
    background: var(--white);
    color: var(--navy);
    box-shadow: 6px 6px 0 rgba(255,255,255,0.3);
  }

  /* ---- LOGOUT ---- */
  .portal-logout {
    margin-top: 2rem;
  }
  .portal-logout-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
    transition: color 0.15s;
  }
  .portal-logout-btn:hover { color: var(--white); }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.animate-in').forEach((el) => observer.observe(el));
</script>
